soong_namespace {
     imports: [
          "hardware/lineage/interfaces/power-libperfmgr",
          "hardware/qcom-caf/common/libqti-perfd-client",
          "hardware/google/interfaces",
          "hardware/google/pixel",
          "hardware/qcom-caf/bootctrl",
          "hardware/xiaomi"
     ],
}

install_symlink {
    name: "libimscamera_jni_symlink",
    system_ext_specific: true,
    installed_location: "priv-app/ims/lib/arm64/libimscamera_jni.so",
    symlink_target: "/system/system_ext/lib64/libimscamera_jni.so",
}

install_symlink {
    name: "libimsmedia_jni_symlink",
    system_ext_specific: true,
    installed_location: "priv-app/ims/lib/arm64/libimsmedia_jni.so",
    symlink_target: "/system/system_ext/lib64/libimsmedia_jni.so",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/WCNSS_qcom_cfg.ini",
}

install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/wlan_mac.bin",
}

install_symlink {
    name: "libEGL_adreno_symlink32",
    vendor: true,
    installed_location: "lib/libEGL_adreno.so",
    symlink_target: "egl/libEGL_adreno.so",
}

install_symlink {
    name: "libGLESv2_adreno_symlink32",
    vendor: true,
    installed_location: "lib/libGLESv2_adreno.so",
    symlink_target: "egl/libGLESv2_adreno.so",
}

install_symlink {
    name: "libq3dtools_adreno_symlink32",
    vendor: true,
    installed_location: "lib/libq3dtools_adreno.so",
    symlink_target: "egl/libq3dtools_adreno.so",
}

install_symlink {
    name: "libEGL_adreno_symlink64",
    vendor: true,
    installed_location: "lib64/libEGL_adreno.so",
    symlink_target: "egl/libEGL_adreno.so",
}

install_symlink {
    name: "libGLESv2_adreno_symlink64",
    vendor: true,
    installed_location: "lib64/libGLESv2_adreno.so",
    symlink_target: "egl/libGLESv2_adreno.so",
}

install_symlink {
    name: "libq3dtools_adreno_symlink64",
    vendor: true,
    installed_location: "lib64/libq3dtools_adreno.so",
    symlink_target: "egl/libq3dtools_adreno.so",
}
